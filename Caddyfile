# Caddy fronts the whole app on one domain and gets automatic HTTPS from
# Let's Encrypt (just point the domain's DNS at this server, ports 80+443 open).
# The browser only ever talks to the dashboard; the dashboard proxies /api and
# /ws on to the backend internally (see apps/dashboard/next.config.ts), so a
# single public origin covers the UI, the API and the realtime socket.
#
# APP_DOMAIN examples:
#   app.tudominio.com        → real domain, automatic HTTPS
#   :80                      → plain HTTP, for quick IP-only testing (no certificate)
#   http://app.tudominio.com → plain HTTP on a real hostname, no certificate —
#                              use this when something else already terminates
#                              TLS in front of Caddy (e.g. a Cloudflare Tunnel)

{$APP_DOMAIN} {
	encode zstd gzip

	# API + realtime WebSocket go straight to the engine (Fastify on :4000).
	# We route them here rather than through the dashboard's Next rewrite because
	# Next bakes rewrite destinations at BUILD time — so the engine URL would be
	# frozen into the image. At Caddy it stays a runtime concern.
	@backend path /api/* /ws
	handle @backend {
		reverse_proxy engine:4000
	}

	# Everything else is the dashboard UI.
	handle {
		reverse_proxy dashboard:3000
	}
}

# Public marketing site (apps/web). Served whenever MARKETING_DOMAIN is set
# in .env; otherwise the `web` container just idles.
{$MARKETING_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3001
}
