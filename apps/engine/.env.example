# Engine HTTP/WS port
PORT=4000

# --- Process role (store/whatsapp split) -------------------------------------
# 'all'      = classic combined monolith (store API + WhatsApp + workers). Default.
# 'store'    = dashboard API/WS + store-side workers only.
# 'whatsapp' = Baileys sockets + WhatsApp-side workers only.
# The two split roles share one DATABASE_URL and talk over the internal keys below.
ROLE=all
# Mutual internal service keys (only used when ROLE != all). Long random strings.
STORE_INTERNAL_KEY=change-me-store-internal
WA_INTERNAL_KEY=change-me-wa-internal
# Where each role reaches the other (service URLs). Only used when split.
WA_INTERNAL_URL=http://whatsapp:4000
STORE_INTERNAL_URL=http://store:4000

# --- Product images (Cloudflare R2, S3-compatible) ---------------------------
# Empty R2_ACCOUNT_ID = uploads disabled (endpoint returns 503).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL (or custom domain), no trailing slash.
R2_PUBLIC_BASE_URL=

# Shared secret the dashboard uses to talk to the engine
DASHBOARD_TOKEN=change-me

# Anthropic API key — without it the AI Employee is disabled and all
# conversations behave as "human mode"
ANTHROPIC_API_KEY=

# Claude model used for replies
AI_MODEL=claude-sonnet-5

# --- Postgres (D1) -----------------------------------------------------------
# Connection string. Defaults to the local embedded dev server (`pnpm pg:dev`).
# In production point this at managed Postgres (Neon/Supabase/RDS).
DATABASE_URL=postgres://postgres:password@localhost:5433/wabos

# --- Auth (D2) ---------------------------------------------------------------
# Secret used to sign dashboard JWTs. MUST be a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# --- CORS (D4) ---------------------------------------------------------------
# Lock API/WS access to the dashboard origin in production, e.g.
# https://app.yourdomain.com. Leave empty in dev (permissive).
ALLOWED_ORIGIN=

# --- Sign in with Google -----------------------------------------------------
# OAuth Web client id from Google Cloud Console (APIs & Services → Credentials).
# Must equal NEXT_PUBLIC_GOOGLE_CLIENT_ID in the dashboard. Empty = disabled.
GOOGLE_CLIENT_ID=

# --- Billing (Merchant of Record) --------------------------------------------
# Which billing rail to use. Default: Lemon Squeezy (MoR — handles global cards,
# tax/IGV, and pays out to Peru). Empty keys below = billing disabled (503).
BILLING_PROVIDER=lemonsqueezy
# Lemon Squeezy API key (from Settings → API). Empty = billing disabled.
LEMONSQUEEZY_API_KEY=
# Numeric Store ID (Settings → Stores).
LEMONSQUEEZY_STORE_ID=
# Webhook signing secret (Settings → Webhooks) — used to verify the X-Signature.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant IDs (a variant = a price/plan) for the three self-serve plans. The
# webhook maps these back to plan_tier (a sub on _BASICO or _BASICO_ANNUAL →
# 'basico', etc.). Enterprise is contact-us (set manually), so it has no variant.
# Monthly (required to sell that plan):
LEMONSQUEEZY_VARIANT_BASICO=
LEMONSQUEEZY_VARIANT_AVANZADO=
LEMONSQUEEZY_VARIANT_PRO=
# Annual (optional — leave blank to disable the yearly option for that plan):
LEMONSQUEEZY_VARIANT_BASICO_ANNUAL=
LEMONSQUEEZY_VARIANT_AVANZADO_ANNUAL=
LEMONSQUEEZY_VARIANT_PRO_ANNUAL=
# Dashboard origin the checkout / customer portal / password-reset links use.
DASHBOARD_URL=http://localhost:3000

# --- Email (SMTP) — for password resets etc. -------------------------------
# Leave SMTP_HOST blank in dev: reset links are printed to the engine console
# instead of emailed. In production use any SMTP provider (Gmail app password,
# Resend, SendGrid, Amazon SES, …).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WABOS <no-reply@wabos.co>

# --- Web push (PWA notifications) ------------------------------------------
# Generate one keypair once with:  npx web-push generate-vapid-keys
# Leave blank to disable push (the /api/push/subscribe endpoint returns 503).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@wabos.co

# --- Native push (Firebase Cloud Messaging) for the Capacitor iOS/Android apps --
# From a Firebase service-account JSON (Project settings → Service accounts →
# Generate new private key). Leave blank to disable native push. See
# docs/mobile-native-build.html. Keep the \n escapes in the private key.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
