# =============================================================================
# WABOS — production deploy env (Docker Compose reads this file as ./.env)
# Copy to .env and fill in. NEVER commit the real .env. See docs/deploy-vps.md.
# =============================================================================

# ---- Server / domain --------------------------------------------------------
# The domain the app is served on (Caddy gets automatic HTTPS for it). For a
# quick IP-only test with no certificate, set APP_DOMAIN=:80
APP_DOMAIN=app.wabos.co
# Optional marketing site domain (apps/web). Leave blank if unused.
MARKETING_DOMAIN=wabos.co
# Lock API/WS CORS to the app origin. Should match https://APP_DOMAIN in prod.
ALLOWED_ORIGIN=https://app.wabos.co
# Base URL used in checkout / password-reset links.
DASHBOARD_URL=https://app.wabos.co

# ---- Database ---------------------------------------------------------------
# Password for the bundled Postgres container. Compose builds DATABASE_URL from
# it, so just set a strong value here. (To use managed Postgres instead, set
# DATABASE_URL directly in docker-compose.yml and drop the postgres service.)
POSTGRES_PASSWORD=change-me-strong-db-password

# ---- Secrets ----------------------------------------------------------------
# Signs dashboard JWTs. MUST be long + random. Generate: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
# Legacy single-tenant bearer token (kept for the original workspace). Random it.
DASHBOARD_TOKEN=change-me-random

# Internal service-to-service keys for the store<->whatsapp split ("keys from
# both sides"). Only used when running docker-compose.split.yml, but set them now
# so the switch is zero-config. Generate each: openssl rand -hex 24
STORE_INTERNAL_KEY=change-me-store-internal
WA_INTERNAL_KEY=change-me-wa-internal

# ---- AI (Anthropic) ---------------------------------------------------------
# Without a key the AI Employee is disabled (conversations stay in human mode).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ---- Platform admin (owner-only /admin console) -----------------------------
# Comma-separated emails allowed to see the cross-tenant ops dashboard at /admin.
# Must match the email you LOG IN with. Empty = admin console disabled.
ADMIN_EMAILS=
# Anthropic prices (USD per million tokens) for the admin AI-spend estimate.
# Keep in sync with the Anthropic console. Defaults are Sonnet-tier placeholders.
AI_PRICE_INPUT_PER_M=3
AI_PRICE_OUTPUT_PER_M=15

# ---- Product images (Cloudflare R2, S3-compatible) --------------------------
# Empty R2_ACCOUNT_ID = image uploads disabled (endpoint returns 503). Create an
# R2 bucket + API token in the Cloudflare dashboard, then set:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket (enable public access or attach a custom domain), no
# trailing slash. e.g. https://pub-xxxx.r2.dev  or  https://img.tudominio.com
R2_PUBLIC_BASE_URL=

# ---- Sign in with Google (optional) -----------------------------------------
# OAuth Web client id. Must equal the dashboard build arg NEXT_PUBLIC_GOOGLE_
# CLIENT_ID (set at image build time). Empty = Google sign-in disabled.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- Billing (Lemon Squeezy) — optional -------------------------------------
BILLING_PROVIDER=lemonsqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_BASICO=
LEMONSQUEEZY_VARIANT_AVANZADO=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_BASICO_ANNUAL=
LEMONSQUEEZY_VARIANT_AVANZADO_ANNUAL=
LEMONSQUEEZY_VARIANT_PRO_ANNUAL=

# ---- Email (SMTP) — optional, for password resets ---------------------------
# Blank host = reset links are logged to the container console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WABOS <no-reply@wabos.co>

# ---- Web push (PWA) — optional ----------------------------------------------
# Generate once:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@wabos.co

# ---- Native push (Firebase) — optional --------------------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---- Data backups — optional ------------------------------------------------
# Set a path (inside the container, on a mounted volume) to enable daily JSON
# backups, e.g. /app/apps/engine/data/backups
BACKUP_DIR=
BACKUP_RETENTION=14
